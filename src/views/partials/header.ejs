<% const navPath = typeof currentPath === 'string' ? currentPath : ''; %>
<% const activeNavItem = navPath === '/home' || navPath === '/' ? 'home' : navPath.endsWith('/contest') ? 'contest' : navPath.endsWith('/quiz') ? 'quiz' : navPath.split('#')[1] || ''; %>
<header class="site-header">
    <div class="site-header-inner">
        <a class="site-brand" href="/home" aria-label="Quizzo home">
            <span class="site-brand-name">Quizzo</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
            <div class="site-nav-heading">
                <span>Menu</span>
                <button class="site-nav-close" type="button" aria-label="Close navigation menu" data-nav-close>
                    <i data-lucide="x" aria-hidden="true"></i>
                </button>
            </div>
            <a class="site-nav-link<%= activeNavItem === 'home' ? ' is-active' : '' %>" href="/home" <% if (activeNavItem === 'home') { %>aria-current="page"<% } %>>Home</a>
            <a class="site-nav-link<%= activeNavItem === 'contest' ? ' is-active' : '' %>" href="/contest" <% if (activeNavItem === 'contest') { %>aria-current="page"<% } %>>Contest</a>
            <a class="site-nav-link<%= activeNavItem === 'quiz' ? ' is-active' : '' %>" href="/quiz" <% if (activeNavItem === 'quiz') { %>aria-current="page"<% } %>>Quiz</a>
        </nav>

        <div class="site-header-actions">
            <button class="site-theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" data-navbar-theme-toggle>
                <i data-lucide="sun" data-navbar-theme-icon="sun" aria-hidden="true"></i>
                <i data-lucide="moon" data-navbar-theme-icon="moon" aria-hidden="true" style="display:none"></i>
            </button>
            <button class="site-icon-button" type="button" aria-label="Notifications">
                <i data-lucide="bell" aria-hidden="true"></i>
            </button>
            <span class="site-avatar" role="img" aria-label="Profile" title="Profile">
                <i data-lucide="user" aria-hidden="true"></i>
            </span>
            <button class="site-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-nav" data-nav-open>
                <i data-lucide="menu" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <button class="site-nav-backdrop" type="button" aria-label="Close navigation menu" data-nav-backdrop hidden></button>
</header>
