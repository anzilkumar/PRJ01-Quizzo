<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head', {
        pageTitle: 'Create your account',
        metaDescription: 'Create your Quizzo account and start challenging your knowledge.',
        styles: ['/css/login.css']
    }) %>
</head>
<body class="quizzo-body">

<main class="login-page" id="signup-page" aria-label="Create your Quizzo account">
    <section class="login-brand-panel" aria-hidden="true">
        <span class="deco-orb deco-orb--mid" aria-hidden="true"></span>

        <a href="/" class="brand-logo" tabindex="-1">
            <span class="brand-logo-mark"><i data-lucide="zap"></i></span>
            <span class="brand-logo-name">Quizzo</span>
        </a>

        <div class="brand-content">
            <p class="brand-tagline-eyebrow">Quiz platform</p>
            <h2 class="brand-heading">Challenge your<br /><em>knowledge.</em><br />Daily.</h2>
            <p class="brand-subheading">
                Compete in live quizzes, sharpen your skills, and climb the leaderboard — one question at a time.
            </p>

            <div class="brand-features">
                <span class="brand-feature-pill"><i data-lucide="zap"></i>Live quizzes</span>
                <span class="brand-feature-pill"><i data-lucide="trophy"></i>Leaderboards</span>
                <span class="brand-feature-pill"><i data-lucide="users"></i>Multiplayer</span>
                <span class="brand-feature-pill"><i data-lucide="bar-chart-2"></i>Analytics</span>
            </div>

            <div class="brand-visual">
                <div class="brand-stat-cards">
                    <div class="brand-stat-card"><div class="brand-stat-number">10K+</div><div class="brand-stat-label">Questions</div></div>
                    <div class="brand-stat-card"><div class="brand-stat-number">50K+</div><div class="brand-stat-label">Players</div></div>
                    <div class="brand-stat-card"><div class="brand-stat-number">200+</div><div class="brand-stat-label">Categories</div></div>
                </div>
            </div>
        </div>

        <footer class="brand-footer">&copy; <%= new Date().getFullYear() %> Quizzo. All rights reserved.</footer>
    </section>

    <section class="login-form-panel">
        <div class="login-theme-toggle">
            <button class="theme-toggle-btn" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" type="button" title="Toggle theme (Alt+D)">
                <i data-lucide="moon" data-theme-icon="moon" aria-hidden="true"></i>
                <i data-lucide="sun" data-theme-icon="sun" aria-hidden="true" style="display:none"></i>
            </button>
        </div>

        <div class="login-card" id="signup-card">
            <header class="login-card-header">
                <p class="login-welcome-text">Get started</p>
                <h1 class="login-heading">Create your account</h1>
                <p class="login-subheading">Join Quizzo and put your knowledge to the test.</p>
            </header>

            <form class="login-form" id="signup-form" aria-label="Signup form" novalidate>
                <div class="form-field">
                    <label class="form-label" for="name">Full name</label>
                    <div class="form-input-wrapper">
                        <span class="form-input-icon" aria-hidden="true"><i data-lucide="user"></i></span>
                        <input class="form-input form-input--with-icon" type="text" id="name" name="name" placeholder="Your name" autocomplete="name" required aria-required="true" aria-describedby="name-error" maxlength="50" />
                    </div>
                    <span class="form-field-error" id="name-error" role="alert" aria-live="polite" hidden></span>
                </div>

                <div class="form-field">
                    <label class="form-label" for="email">Email address</label>
                    <div class="form-input-wrapper">
                        <span class="form-input-icon" aria-hidden="true"><i data-lucide="mail"></i></span>
                        <input class="form-input form-input--with-icon" type="email" id="email" name="email" placeholder="quizzo@example.com" autocomplete="email" required aria-required="true" aria-describedby="email-error" />
                    </div>
                    <span class="form-field-error" id="email-error" role="alert" aria-live="polite" hidden></span>
                </div>

                <div class="form-field">
                    <label class="form-label" for="password">Password</label>
                    <div class="form-input-wrapper">
                        <span class="form-input-icon" aria-hidden="true"><i data-lucide="lock"></i></span>
                        <input class="form-input form-input--with-icon form-input--with-trailing" type="password" id="password" name="password" placeholder="Create a password" autocomplete="new-password" required aria-required="true" aria-describedby="password-error" />
                        <button class="password-toggle" type="button" id="password-toggle" aria-label="Show password" aria-controls="password" aria-pressed="false" data-password-label="password">
                            <i data-lucide="eye" data-eye aria-hidden="true"></i>
                            <%- include('../../partials/password-eye-off') %>
                        </button>
                    </div>
                    <span class="form-field-error" id="password-error" role="alert" aria-live="polite" hidden></span>
                </div>

                <div class="form-field">
                    <label class="form-label" for="referral-code">Referral Code (Optional)</label>
                    <div class="form-input-wrapper">
                        <span class="form-input-icon" aria-hidden="true"><i data-lucide="tag"></i></span>
                        <input class="form-input form-input--with-icon" type="text" id="referral-code" name="referralCode" placeholder="QZ-EV892" autocomplete="off" />
                    </div>
                </div>

                <button class="btn-login" type="button" id="btn-signup" aria-label="Create account">
                    <span class="btn-login-label">Create account</span>
                </button>
            </form>

            <div class="form-divider">
                <span class="form-divider-text">OR</span>
            </div>

            <button class="btn-google" id="btn-google-signup" type="button" aria-label="Sign Up with Google">
                <svg class="google-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.47 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Sign Up with Google
            </button>

            <p class="login-subheading login-signup">Already have an account? <a href="/">Sign in</a></p>
        </div>
    </section>
</main>

<%- include('../../partials/scripts', { scripts: [] }) %>
<script type="module" src="/js/signup.js"></script>

</body>
</html>
