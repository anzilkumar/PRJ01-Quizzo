<!doctype html>
<html lang="en">
<head>
    <%- include('../../partials/admin-recovery-head', { pageTitle: 'Set a new password', description: 'Choose a new password for your Quizzo administration account.' }) %>
</head>
<body class="admin-body admin-recovery-body">
    <main class="admin-recovery-shell" id="admin-change-password-page">
        <section class="admin-recovery-card change-password-card" aria-labelledby="recovery-title">
            <div class="recovery-topline">
                <a class="recovery-back recovery-back--circle" href="/admin/forgot-password" aria-label="Back to forgot password" title="Back to forgot password"><i data-lucide="arrow-left" aria-hidden="true"></i></a>
                <div class="recovery-progress" aria-label="Step 3 of 3"><span>03/03</span><div class="recovery-progress-bars"><i class="is-complete"></i><i class="is-complete"></i><i class="is-active"></i></div></div>
            </div>

            <header class="admin-recovery-header">
                <div class="eyebrow"><span class="eyebrow-rule"></span>ACCOUNT RECOVERY</div>
                <h1 id="recovery-title">Set a new password</h1>
                <p>Choose a new password to secure your admin account.</p>
            </header>

            <form class="admin-recovery-form change-password-form" id="admin-change-password-form" novalidate>
                <div class="recovery-field">
                    <label for="admin-new-password">NEW PASSWORD</label>
                    <div class="recovery-input-wrap">
                        <span class="recovery-input-icon"><i data-lucide="lock-keyhole" aria-hidden="true"></i></span>
                        <input id="admin-new-password" name="newPassword" type="password" placeholder="Enter new password" autocomplete="new-password" required aria-describedby="admin-new-password-error">
                        <button class="recovery-password-toggle" type="button" aria-label="Show new password" aria-controls="admin-new-password" aria-pressed="false" data-password-toggle data-password-label="new password"><i data-lucide="eye" data-eye aria-hidden="true"></i><%- include('../../partials/password-eye-off') %></button>
                    </div>
                    <span class="recovery-error" id="admin-new-password-error" role="alert" aria-live="polite" hidden></span>
                </div>
                <div class="recovery-field">
                    <label for="admin-confirm-password">CONFIRM NEW PASSWORD</label>
                    <div class="recovery-input-wrap">
                        <span class="recovery-input-icon"><i data-lucide="lock-keyhole" aria-hidden="true"></i></span>
                        <input id="admin-confirm-password" name="confirmPassword" type="password" placeholder="Confirm new password" autocomplete="new-password" required aria-describedby="admin-confirm-password-error">
                        <button class="recovery-password-toggle" type="button" aria-label="Show confirmed password" aria-controls="admin-confirm-password" aria-pressed="false" data-password-toggle data-password-label="confirmed password"><i data-lucide="eye" data-eye aria-hidden="true"></i><%- include('../../partials/password-eye-off') %></button>
                    </div>
                    <span class="recovery-error" id="admin-confirm-password-error" role="alert" aria-live="polite" hidden></span>
                </div>
                <button class="button button-primary recovery-primary" type="submit">Update Password</button>
            </form>
        </section>
    </main>

    <dialog class="password-success-dialog" id="admin-password-success" aria-labelledby="success-title" aria-describedby="success-description">
        <div class="success-icon"><i data-lucide="check" aria-hidden="true"></i></div>
        <h2 id="success-title">Password updated</h2>
        <p id="success-description">Your password has been changed. You can now sign in with your new password.</p>
        <a class="button button-primary recovery-primary" href="/admin"><i data-lucide="arrow-left" aria-hidden="true"></i>Back to login</a>
    </dialog>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>document.addEventListener('DOMContentLoaded', () => window.lucide?.createIcons());</script>
    <script type="module" src="/js/admin-change-password.js"></script>
</body>
</html>
