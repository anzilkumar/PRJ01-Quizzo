<%- include('../../partials/admin-start', { page }) %>
<div class="sample-note"><i data-lucide="info"></i><span><%= sampleLabel %> · Search and filters act on these examples in this browser only.</span></div>
<section class="panel table-panel"><div class="table-tools"><label class="search-box"><i data-lucide="search"></i><input type="search" placeholder="Search <%= page.title.toLowerCase() %>…" aria-label="Search <%= page.title.toLowerCase() %>" data-search></label><div class="tool-actions"><label class="filter-select"><i data-lucide="list-filter"></i><select aria-label="Filter by status" data-filter><option value="">All statuses</option><option>Published</option><option>Draft</option><option>Scheduled</option><option>Active</option><option>Paused</option><option>Live</option><option>Ended</option></select></label><button type="button" class="icon-button" aria-label="More table options" data-toast="No additional options in this preview."><i data-lucide="ellipsis"></i></button></div></div>
<div class="table-wrap"><table><thead><tr><% page.columns.forEach(column => { %><th><%= column.toUpperCase() %></th><% }); %><th><span class="sr-only">Actions</span></th></tr></thead><tbody data-rows><% page.rows.forEach((row, index) => { %><tr data-row><% row.forEach((cell, i) => { %><td><% if (i === 0) { %><a class="row-primary" href="<%= page.type === 'quizzes' ? '/admin/quizzes/sample-' + (index + 1) : page.type === 'users' ? '/admin/users/sample-' + (index + 1) : '/admin/competitions/sample-' + (index + 1) %>"><%= cell %></a><% } else if (['Published','Draft','Scheduled','Active','Paused','Live','Ended'].includes(cell)) { %><span class="status-pill <%= cell.toLowerCase() %>"><span></span><%= cell %></span><% } else { %><span><%= cell %></span><% } %></td><% }); %><td><button class="icon-button row-menu" type="button" aria-label="Actions for <%= row[0] %>" data-row-menu><i data-lucide="ellipsis"></i></button></td></tr><% }); %></tbody></table><div class="empty-state" data-empty hidden>No matching entries. Try another search.</div></div>
<div class="table-bottom"><span data-result-count>Showing <%= page.rows.length %> illustrative records</span><div class="pagination"><button class="page-button active" type="button" aria-current="page">1</button><button class="page-button" type="button" data-toast="This preview contains one sample page.">2</button><button class="page-button" type="button" data-toast="This preview contains one sample page.">3</button><span>…</span><button class="page-button" type="button" data-toast="This preview contains one sample page."><i data-lucide="chevron-right"></i></button></div></div></section>
<div class="toast" role="status" aria-live="polite" data-toast-box hidden></div>
<dialog class="preview-dialog" data-preview-dialog aria-labelledby="preview-title"><button class="icon-button dialog-close" type="button" aria-label="Close" data-dialog-close><i data-lucide="x"></i></button><div class="eyebrow">ILLUSTRATIVE RECORD</div><h2 id="preview-title">Record preview</h2><p data-dialog-copy>This example record is for layout preview only.</p><a class="button button-primary" data-dialog-link href="/admin">Open details <i data-lucide="arrow-up-right"></i></a></dialog>
<%- include('../../partials/admin-end') %>
