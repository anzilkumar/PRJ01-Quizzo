<!doctype html>
<html lang="en">
<head>
    <%- include('../../partials/admin-recovery-head', { pageTitle: 'Forgot your password?', description: 'Request an administrative verification code for your Quizzo account.' }) %>
</head>
<body class="admin-body admin-recovery-body">
    <main class="admin-recovery-shell">
        <section class="admin-recovery-card" aria-labelledby="recovery-title">
            <div class="recovery-topline">
                <a class="recovery-back recovery-back--circle" href="/admin" aria-label="Back to login" title="Back to login"><i data-lucide="arrow-left" aria-hidden="true"></i></a>
                <div class="recovery-progress" aria-label="Step 1 of 3"><span>01/03</span><div class="recovery-progress-bars"><i class="is-active"></i><i></i><i></i></div></div>
            </div>

            <header class="admin-recovery-header">
                <div class="eyebrow"><span class="eyebrow-rule"></span>ACCOUNT RECOVERY</div>
                <h1 class="admin-forgot-title" id="recovery-title">Forgot your password?</h1>
                <p>Enter your registered email address to receive a one-time verification code.</p>
            </header>

            <form class="admin-recovery-form" id="admin-forgot-form" novalidate>
                <div class="recovery-field">
                    <label for="admin-recovery-email">Email address</label>
                    <div class="recovery-input-wrap">
                        <span class="recovery-input-icon"><i data-lucide="mail" aria-hidden="true"></i></span>
                        <input id="admin-recovery-email" name="email" type="email" placeholder="admin@quizzo.com" autocomplete="email" autocapitalize="off" spellcheck="false" required aria-describedby="admin-recovery-email-error">
                    </div>
                    <span class="recovery-error" id="admin-recovery-email-error" role="alert" aria-live="polite" hidden></span>
                </div>
                <button class="button button-primary recovery-primary" type="submit">Send Verification Code<i data-lucide="arrow-right" aria-hidden="true"></i></button>
            </form>
        </section>
    </main>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>document.addEventListener('DOMContentLoaded', () => window.lucide?.createIcons());</script>
    <script type="module" src="/js/admin-forgot-password.js"></script>
</body>
</html>
