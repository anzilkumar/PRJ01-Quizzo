<%- include('../../partials/admin-start', { page }) %>
<div class="sample-note"><i data-lucide="info"></i><span>Illustrative sample profile · no live records are connected</span></div>
<section class="detail-layout"><article class="panel detail-card"><div class="detail-symbol"><i data-lucide="<%= page.kind === 'quiz' ? 'notebook-tabs' : page.kind === 'user' ? 'user-round' : 'trophy' %>"></i></div><div class="eyebrow">OVERVIEW</div><h2><%= page.title %></h2><p class="detail-copy"><%= page.intro %></p><dl class="detail-fields"><% page.fields.forEach(([label,value]) => { %><div><dt><%= label %></dt><dd><%= value %></dd></div><% }); %></dl><div class="detail-actions"><a class="button button-primary" href="<%= page.kind === 'quiz' ? '/admin/quizzes/sample-1/edit' : page.kind === 'competition' ? '/admin/competitions/sample-1/edit' : '/admin/users' %>"><i data-lucide="pencil"></i><%= page.kind === 'user' ? 'Back to people' : 'Edit details' %></a><a class="button button-quiet" href="/admin/<%= page.kind === 'quiz' ? 'quizzes' : page.kind === 'user' ? 'users' : 'competitions' %>">Return to list</a></div></article><aside class="panel note-card"><div class="eyebrow">A NOTE</div><h3>Preview profile</h3><p>This page uses clearly illustrative content to show how a record detail view can be presented. Connect real data when the backend is ready.</p></aside></section>
<%- include('../../partials/admin-end') %>
