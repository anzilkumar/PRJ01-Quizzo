<!doctype html>
<html lang="en">
<head>
    <%- include('../../partials/admin-recovery-head', { pageTitle: 'Enter verification code', description: 'Enter the six-digit Quizzo administration verification code.' }) %>
</head>
<body class="admin-body admin-recovery-body">
    <main class="admin-recovery-shell">
        <section class="admin-recovery-card" aria-labelledby="recovery-title">
            <div class="recovery-topline">
                <a class="recovery-back recovery-back--circle" href="/admin/forgot-password" aria-label="Back to email" title="Back to email"><i data-lucide="arrow-left" aria-hidden="true"></i></a>
                <div class="recovery-progress" aria-label="Step 2 of 3"><span>02/03</span><div class="recovery-progress-bars"><i class="is-complete"></i><i class="is-active"></i><i></i></div></div>
            </div>

            <header class="admin-recovery-header">
                <div class="eyebrow"><span class="eyebrow-rule"></span>ACCOUNT RECOVERY</div>
                <h1 id="recovery-title">Enter verification code</h1>
                <p>We sent a 6-digit code to <strong class="recovery-email-display" data-recovery-email>your administrative email</strong>. Enter it below to continue.</p>
            </header>

            <form class="admin-recovery-form verify-code-form" id="admin-verify-form" novalidate>
                <div class="otp-inputs" role="group" aria-label="Six-digit verification code">
                    <% for (let digit = 1; digit <= 6; digit++) { %>
                        <input class="otp-digit" id="admin-otp-<%= digit %>" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="<%= digit === 1 ? 'one-time-code' : 'off' %>" aria-label="Digit <%= digit %> of 6" aria-describedby="admin-otp-error">
                    <% } %>
                </div>
                <span class="recovery-error otp-error" id="admin-otp-error" role="alert" aria-live="polite" hidden></span>
                <button class="button button-primary recovery-primary" type="submit">Verify Code<i data-lucide="arrow-right" aria-hidden="true"></i></button>
            </form>

            <div class="resend-area">
                <p>Didn't receive code? <span class="resend-label" role="link" tabindex="0">Resend code</span></p>
            </div>
        </section>
    </main>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>document.addEventListener('DOMContentLoaded', () => window.lucide?.createIcons());</script>
    <script type="module" src="/js/admin-verify-code.js"></script>
</body>
</html>
