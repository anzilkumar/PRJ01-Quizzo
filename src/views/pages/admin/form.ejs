<%- include('../../partials/admin-start', { page }) %>
<div class="sample-note"><i data-lucide="info"></i><span>Frontend preview · changes are not saved</span></div>
<form class="panel editor-form" data-editor-form><div class="editor-intro"><div class="eyebrow">DETAILS</div><p>Fields are for interface preview only. No records will be created or changed.</p></div><div class="form-grid"><label class="field field-wide"><span><%= page.kind === 'quiz' ? 'Quiz title' : 'Competition name' %></span><input name="title" placeholder="Give it a thoughtful name" required></label><label class="field"><span>Category</span><select><option>Select a category</option><option>Culture</option><option>Science</option><option>History</option><option>Language</option></select></label><label class="field"><span>Status</span><select><option>Draft</option><option>Published</option><option>Scheduled</option></select></label><label class="field field-wide"><span>Description</span><textarea rows="4" placeholder="A short introduction"></textarea></label><% if (page.kind === 'quiz') { %><label class="field"><span>Number of questions</span><input type="number" min="1" placeholder="e.g. 12"></label><label class="field"><span>Estimated duration</span><input placeholder="e.g. 8 minutes"></label><% } else { %><label class="field"><span>Opens</span><input type="date"></label><label class="field"><span>Closes</span><input type="date"></label><% } %></div><div class="form-actions"><a class="button button-quiet" href="/admin/<%= page.kind === 'quiz' ? 'quizzes' : 'competitions' %>">Cancel</a><button class="button button-primary" type="submit"><i data-lucide="eye"></i>Preview form</button></div></form><div class="toast" role="status" aria-live="polite" data-toast-box hidden></div>
<%- include('../../partials/admin-end') %>
