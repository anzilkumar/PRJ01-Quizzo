<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head', {
        pageTitle: 'Forgot password',
        metaDescription: 'Request a password reset code for your Quizzo account.',
        styles: ['/css/login.css', '/css/forgot-password.css']
    }) %>
</head>
<body class="quizzo-body">
<main class="recovery-page" aria-labelledby="recovery-heading">
    <div class="recovery-theme-toggle">
        <button class="theme-toggle-btn" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" type="button" title="Toggle theme (Alt+D)">
            <i data-lucide="moon" data-theme-icon="moon" aria-hidden="true"></i>
            <i data-lucide="sun" data-theme-icon="sun" aria-hidden="true" style="display:none"></i>
        </button>
    </div>

    <section class="recovery-card" aria-label="Password recovery">
        <header class="recovery-card-header">
            <h1 class="recovery-heading" id="recovery-heading">Forgot Password?</h1>
            <p class="recovery-description">Enter your email and we'll send you a code.</p>
        </header>

        <form class="recovery-form" id="forgot-password-form" aria-label="Password recovery email" novalidate>
            <div class="form-field">
                <label class="form-label" for="forgot-email">Email address</label>
                <div class="form-input-wrapper">
                    <span class="form-input-icon" aria-hidden="true"><i data-lucide="mail"></i></span>
                    <input
                        class="form-input form-input--with-icon"
                        type="email"
                        id="forgot-email"
                        name="email"
                        placeholder="quizzo@example.com"
                        autocomplete="email"
                        autocapitalize="off"
                        spellcheck="false"
                        required
                        aria-required="true"
                        aria-describedby="forgot-email-error"
                    />
                </div>
                <span class="form-field-error" id="forgot-email-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <button class="btn-login recovery-submit" type="submit" id="send-code-button">
                <span class="btn-login-label">Send Code</span>
                <i data-lucide="arrow-right" aria-hidden="true"></i>
            </button>
        </form>

        <p class="recovery-back login-subheading">Remember your password? <a href="/">Log in</a></p>
    </section>
</main>

<%- include('../../partials/scripts', { scripts: [] }) %>
<script type="module" src="/js/forgot-password.js"></script>
</body>
</html>
