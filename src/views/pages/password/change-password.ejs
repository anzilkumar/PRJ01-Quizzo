<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head', {
        pageTitle: 'Change password',
        metaDescription: 'Create a new password for your Quizzo account.',
        styles: ['/css/login.css', '/css/forgot-password.css', '/css/change-password.css']
    }) %>
</head>
<body class="quizzo-body">
<main class="recovery-page" id="change-password-page" aria-labelledby="change-password-heading">
    <div class="recovery-theme-toggle">
        <button class="theme-toggle-btn" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" type="button" title="Toggle theme (Alt+D)">
            <i data-lucide="moon" data-theme-icon="moon" aria-hidden="true"></i>
            <i data-lucide="sun" data-theme-icon="sun" aria-hidden="true" style="display:none"></i>
        </button>
    </div>

    <section class="recovery-card change-password-card" aria-label="Change password">
        <header class="recovery-card-header">
            <h1 class="recovery-heading" id="change-password-heading">Change Password</h1>
            <p class="recovery-description">Create a new password for your account</p>
        </header>

        <form class="change-password-form" id="change-password-form" novalidate>
            <div class="form-field">
                <label class="form-label" for="new-password">New Password</label>
                <div class="form-input-wrapper">
                    <span class="form-input-icon" aria-hidden="true"><i data-lucide="lock"></i></span>
                    <input class="form-input form-input--with-icon form-input--with-trailing" type="password" id="new-password" name="newPassword" placeholder="Enter new password" autocomplete="new-password" required aria-required="true" aria-describedby="new-password-error" />
                    <button class="password-toggle" type="button" id="new-password-toggle" aria-label="Show new password" aria-controls="new-password" aria-pressed="false" data-password-label="new password">
                        <i data-lucide="eye" data-eye aria-hidden="true"></i>
                        <%- include('../../partials/password-eye-off') %>
                    </button>
                </div>
                <span class="form-field-error" id="new-password-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <div class="form-field">
                <label class="form-label" for="confirm-password">Confirm Password</label>
                <div class="form-input-wrapper">
                    <span class="form-input-icon" aria-hidden="true"><i data-lucide="lock"></i></span>
                    <input class="form-input form-input--with-icon form-input--with-trailing" type="password" id="confirm-password" name="confirmPassword" placeholder="Confirm new password" autocomplete="new-password" required aria-required="true" aria-describedby="confirm-password-error" />
                    <button class="password-toggle" type="button" id="confirm-password-toggle" aria-label="Show confirm password" aria-controls="confirm-password" aria-pressed="false" data-password-label="confirm password">
                        <i data-lucide="eye" data-eye aria-hidden="true"></i>
                        <%- include('../../partials/password-eye-off') %>
                    </button>
                </div>
                <span class="form-field-error" id="confirm-password-error" role="alert" aria-live="polite" hidden></span>
            </div>

            <button class="btn-login recovery-submit" id="update-password-button" type="submit">
                <span class="btn-login-label">Update Password</span>
            </button>
        </form>
    </section>
</main>

<div class="success-modal" id="password-success-modal" role="dialog" aria-modal="true" aria-labelledby="password-success-title" aria-describedby="password-success-description" hidden>
    <section class="success-modal-card">
        <span class="success-modal-icon" aria-hidden="true"><i data-lucide="check"></i></span>
        <h2 class="success-modal-title" id="password-success-title">Password Changed Successfully!</h2>
        <p class="success-modal-description" id="password-success-description">Your password has been reset successfully. You can now sign in using your new password.</p>
        <button class="btn-login recovery-submit" id="continue-to-login-button" type="button">
            <span class="btn-login-label">Continue to Login</span>
        </button>
    </section>
</div>

<%- include('../../partials/scripts', { scripts: [] }) %>
<script type="module" src="/js/change-password.js"></script>
</body>
</html>
